<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FlowRun: runs the methods of an assembly on .NET with random arguments,
    the reference side of xtask's `cil:exec` check. It references no NuGet
    packages, so it restores and builds offline, inside the Nix sandbox,
    where the root flake's `flowRun` derivation builds it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>FlowRun</AssemblyName>
    <RootNamespace>FlowRun</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
