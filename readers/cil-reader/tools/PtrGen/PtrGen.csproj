<Project Sdk="Microsoft.NET.Sdk">
  <!--
    dnlib's sources are compiled straight into this executable, as CecilDump
    does with Cecil's, so it restores and builds offline inside the Nix
    sandbox, where the root flake's `cilPtrFixtures` derivation runs it.

    DnlibSrc is the dnlib checkout; it defaults to a hand-cloned extern/dnlib.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>PtrGen</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DnlibSrc Condition="'$(DnlibSrc)' == ''">$(MSBuildThisFileDirectory)../../extern/dnlib</DnlibSrc>
    <!-- dnlib's resource code uses BinaryFormatter, obsolete on net8.0. -->
    <NoWarn>$(NoWarn);CS0618;CS1591;CS8981;SYSLIB0011;SYSLIB0050;SYSLIB0051</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(DnlibSrc)/src/**/*.cs" Exclude="$(DnlibSrc)/src/obj/**;$(DnlibSrc)/src/bin/**" />
  </ItemGroup>
</Project>
