{
  // Flow: obj.data = source() (15) -> local = obj.data (16) -> sink(local) (17).
  // Line 16 is dropped: `local = obj.data` is a pure copy that copy_alias
  // collapses onto the field, so the read at line 16 surfaces in neither the
  // human code flow nor the machine tainted-instructions.
  "expected_lines": [
    15,
    17
  ],
  "model_generators": [
    {
      "find": "methods",
      "where": [
        {
          "constraint": "signature_match",
          "name": "source",
          "parent": "LFieldFlow;"
        }
      ],
      "model": {
        "sources": [
          {
            "kind": "UserInput",
            "port": "Return"
          }
        ]
      }
    },
    {
      "find": "methods",
      "where": [
        {
          "constraint": "signature_match",
          "name": "sink",
          "parent": "LFieldFlow;"
        }
      ],
      "model": {
        "sinks": [
          {
            "kind": "TaintedData",
            "port": "Argument(0)"
          }
        ]
      }
    }
  ]
}