{
  // Flow: arr[1] = source() (13) -> local = arr[1] (14) -> sink(local) (15).
  // Line 14 is dropped: `local = arr[1]` is a pure copy, so the copy_alias
  // union-find (the query's Theta(C^2)->O(C) optimization) collapses `local`
  // onto `arr[1]`, and the read at line 14 appears in neither the human code
  // flow nor the machine tainted-instructions. The taint still reaches the sink.
  "expected_lines": [
    13,
    15
  ],
  "model_generators": [
    {
      "find": "methods",
      "where": [
        {
          "constraint": "signature_match",
          "name": "source",
          "parent": "LArrayFlow;"
        }
      ],
      "model": {
        "sources": [
          {
            "kind": "UserInput",
            "port": "Return"
          }
        ]
      }
    },
    {
      "find": "methods",
      "where": [
        {
          "constraint": "signature_match",
          "name": "sink",
          "parent": "LArrayFlow;"
        }
      ],
      "model": {
        "sinks": [
          {
            "kind": "TaintedData",
            "port": "Argument(0)"
          }
        ]
      }
    }
  ]
}