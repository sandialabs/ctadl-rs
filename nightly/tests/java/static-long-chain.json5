{
  // Flow: a = b = source() (15) -> sink(a) (16) and sink(b) (17). javac copies
  // the long's two slots with `dup2` between the two putstatics.
  "expected_lines": [15, 16, 17],
  "model_generators": [
    {
      "find": "methods",
      "where": [{ "constraint": "signature_match", "name": "source", "parent": "LStaticLongChain;" }],
      "model": { "sources": [{ "kind": "UserInput", "port": "Return" }] }
    },
    {
      "find": "methods",
      "where": [{ "constraint": "signature_match", "name": "sink", "parent": "LStaticLongChain;" }],
      "model": { "sinks": [{ "kind": "TaintedData", "port": "Argument(0)" }] }
    }
  ]
}
