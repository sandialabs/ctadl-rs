{
  // Flow: t = source() (19) -> get().data = t (20) -> sink(h.data) (26), where
  // get() returns holder. The store goes to the object get() returned, not to t.
  "expected_lines": [19, 26],
  "model_generators": [
    {
      "find": "methods",
      "where": [
        {
          "constraint": "signature_match",
          "name": "source",
          "parent": "LCallResultFieldStore;"
        }
      ],
      "model": {
        "sources": [
          {
            "kind": "UserInput",
            "port": "Return"
          }
        ]
      }
    },
    {
      "find": "methods",
      "where": [
        {
          "constraint": "signature_match",
          "name": "sink",
          "parent": "LCallResultFieldStore;"
        }
      ],
      "model": {
        "sinks": [
          {
            "kind": "TaintedData",
            "port": "Argument(0)"
          }
        ]
      }
    }
  ]
}
