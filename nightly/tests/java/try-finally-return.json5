{
  // Flow: guarded(source()) (22) returns s from inside a try (15). javac saves
  // the value in a local, copies the finally block onto the normal and the
  // exceptional exit, and returns the local. Line 15 is dropped: the callee only
  // copies its argument through, which copy_alias collapses.
  "expected_lines": [22],
