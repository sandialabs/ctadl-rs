    {
      "find": "methods",
      "where": [{ "constraint": "signature_match", "name": "source", "parent": "LTryFinallyReturn;" }],
      "model": { "sources": [{ "kind": "UserInput", "port": "Return" }] }
    },
    {
      "find": "methods",
      "where": [{ "constraint": "signature_match", "name": "sink", "parent": "LTryFinallyReturn;" }],
      "model": { "sinks": [{ "kind": "TaintedData", "port": "Argument(0)" }] }
    }
  ]
