{
  // Flow: i = source() (13) -> a[i] = i (14) -> sink(a[0]) (15). The stored value
  // is also the index, so dx compiles the store to `aput v0, v1, v0`: the value
  // and the index share a register.
  // Line 14 is dropped: a pure copy into the array
  // (see "Pure copies" in nightly/README.md).
  "expected_lines": [13, 15],
  "model_generators": [
    {
      "find": "methods",
      "where": [{ "constraint": "signature_match", "name": "source", "parent": "LArrayIndexAsValue;" }],
      "model": { "sources": [{ "kind": "UserInput", "port": "Return" }] }
    },
    {
      "find": "methods",
      "where": [{ "constraint": "signature_match", "name": "sink", "parent": "LArrayIndexAsValue;" }],
      "model": { "sinks": [{ "kind": "TaintedData", "port": "Argument(0)" }] }
    }
  ]
}
