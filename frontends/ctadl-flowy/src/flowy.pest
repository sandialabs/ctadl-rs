top = { SOI ~ def* ~ EOI }
def = { var_def | function_def }

var_def = { kw_var ~ ident ~ ";" }

function_def = { kw_def ~ ident ~ params ~ return_arity? ~ where_clause? ~ block_list }
block_list = { "{" ~ block* ~ "}" }
params = {
  "(" ~ ")" |
  "(" ~ param ~ ("," ~ param)* ~ ")"
}
// The second ident is 'byref', but it needs to parse as ident or else it's not
// in the parse tree.
param = { ident ~ param_passing_style? }
param_passing_style = { kw_byref | kw_byval }
return_arity = { ":" ~ int }
where_clause = { kw_where ~ kw_summaries ~ summaries }

block = { ident ~ ":" ~ stmt* ~ terminator }

terminator = { goto_stmt | return_stmt }
stmt = { update_stmt | assign_stmt | assign_call_stmt | call_stmt }

// Functional update: `x2 = [x1.foo := val];` reads "x2 is x1, but with .foo set to val". The
// brackets are what distinguish it from the assignment `x2.foo = val`, which writes through x1.
update_stmt = { ap ~ "=" ~ "[" ~ ap ~ ":=" ~ ap ~ "]" ~ ";" }
assign_stmt = { ap ~ "=" ~ ap_comma_list ~ ";" }
ap_comma_list = { ap ~ ("," ~ ap)* }
assign_call_stmt = { ap ~ "=" ~ ap ~ actuals ~ ";" }
call_stmt = { ap ~ actuals ~ ";" }
goto_stmt = { kw_goto ~ ident ~ ("," ~ ident)* ~ ";" }
return_stmt = { kw_return ~ ap? ~ ";" }

p = { star_p | field_p | offset_p }
star_p = { "." ~ "*" }
field_p = { "." ~ ident }
offset_p = { "." ~ "[" ~ int ~ "]" }

ap = { function_ptr | ident ~ p* | int | string }
function_ptr = { kw_ptr ~ "<" ~ ident ~ ">" }

actuals = {
  "(" ~ ")" |
  "(" ~ ap ~ ("," ~ ap)* ~ ")"
}

// 'ap' in summary_ap handles the case of the special "return" port.
summary_ap = { ap }
summary_entry = { summary_ap ~ summary_op ~ summary_ap }
summary_op = { "<-" | "</-" }
summaries = {
  "[" ~ "]" |
  "[" ~ summary_entry ~ ("," ~ summary_entry)* ~ "]"
}


// A keyword must not run into an identifier: `returnx;` is a parse error, not `return x;`. The
// boundary check has to be atomic (in a normal rule, `"return" ~ !ident_char` skips whitespace
// before checking), but an atomic rule would add a pair to the parse tree. So each keyword is a
// lookahead on an atomic rule, which leaves no pair, followed by the silent literal.
kw_var = _{ &kw_var_word ~ "var" }
kw_def = _{ &kw_def_word ~ "def" }
kw_byref = _{ &kw_byref_word ~ "byref" }
kw_byval = _{ &kw_byval_word ~ "byval" }
kw_where = _{ &kw_where_word ~ "where" }
kw_summaries = _{ &kw_summaries_word ~ "summaries" }
kw_goto = _{ &kw_goto_word ~ "goto" }
kw_return = _{ &kw_return_word ~ "return" }
kw_ptr = _{ &kw_ptr_word ~ "ptr" }
kw_var_word = @{ "var" ~ !ident_char }
kw_def_word = @{ "def" ~ !ident_char }
kw_byref_word = @{ "byref" ~ !ident_char }
kw_byval_word = @{ "byval" ~ !ident_char }
kw_where_word = @{ "where" ~ !ident_char }
kw_summaries_word = @{ "summaries" ~ !ident_char }
kw_goto_word = @{ "goto" ~ !ident_char }
kw_return_word = @{ "return" ~ !ident_char }
kw_ptr_word = @{ "ptr" ~ !ident_char }
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }
int = { ("+" | "-")? ~ ASCII_DIGIT+ }
ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
string = ${ "\"" ~ inner ~ "\"" }
inner = @{ char* }
char = {
    !("\"" | "\\") ~ ANY
    | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t")
    | "\\" ~ ("u" ~ ASCII_HEX_DIGIT{4})
}
