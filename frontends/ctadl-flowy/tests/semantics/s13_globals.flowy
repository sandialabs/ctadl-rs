// G2, G5: a global is one variable shared by every instance, and nothing is passed for it at a
// call: a global written in a callee reaches the caller. Its storage is the location below it
// (G4), here `g.deref`.
var g;

def Set(p) {
s:
  g.deref = p;
  return;
}

def Main() {
s:
  a = source(S);
  Set(a);
  r = g.deref;
  sink(r, S);
  return;
}

// The observable, every sink each label reaches:
// expect: Main: sink(%S)#0 <- %S
