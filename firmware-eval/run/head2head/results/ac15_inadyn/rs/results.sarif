                  "text": "No taint sources or sinks were configured ({0} model file(s) loaded, no built-in endpoints), so the query has nothing to search for."
                }
              },
              "name": "No endpoints configured",
              "shortDescription": {
                "text": "Neither a source nor a sink was declared anywhere"
              }
            },
            {
              "id": "CTADL0002.no-sources-configured",
              "messageStrings": {
                "default": {
                  "text": "No taint sources were configured, but {0} sink endpoint(s) were. A taint query with no source is vacuous."
                }
              },
              "name": "No sources configured",
              "shortDescription": {
                "text": "Sinks were declared but no source was"
              }
            },
            {
              "id": "CTADL0003.no-sinks-configured",
              "messageStrings": {
                "default": {
                  "text": "No taint sinks were configured, but {0} source endpoint(s) were. A taint query with no sink is vacuous."
                }
              },
              "name": "No sinks configured",
              "shortDescription": {
                "text": "Sources were declared but no sink was"
              }
            },
            {
              "id": "CTADL0004.generator-matched-nothing",
              "messageStrings": {
                "default": {
                  "text": "Model generator {0} in '{1}' declares a {2} that matched nothing in the program, so it contributes nothing to the query."
                },
                "indexTimeDeclaration": {
                  "text": "Model generator {0} in '{1}' declares a {2}, but no function in the program matched its 'where' constraints, so it will contribute nothing when the project is indexed."
                },
                "localNotFound": {
                  "text": "Model generator {0} in '{1}' declares a {2} on port 'Variable({3})': its 'where' constraints matched {4} function(s), but none of them has a local variable named '{3}', so it contributes nothing to the query."
                },
                "mixedReasons": {
                  "text": "Model generator {0} in '{1}' declares {3} {2} port(s), none of which matched anything in the program ({4}), so it contributes nothing to the query."
                },
                "noCallerMatched": {
                  "text": "Model generator {0} in '{1}' declares a {2} at call sites: its 'where' constraints matched {3} function(s), but no caller of them satisfied its 'in_function' constraint, so it contributes nothing to the query."
                },
                "noFunctionMatched": {
                  "text": "Model generator {0} in '{1}' declares a {2}, but no function in the program matched its 'where' constraints, so it contributes nothing to the query."
                },
                "portRejected": {
                  "text": "Model generator {0} in '{1}' declares a {2} on a port that is not valid for its 'find' method, so it contributes nothing to the query."
                }
              },
              "name": "Model generator matched nothing",
              "shortDescription": {
                "text": "A model generator declared a port that produced no endpoint"
              }
            },
            {
              "id": "CTADL0005.endpoint-function-not-indexed",
              "messageStrings": {
                "default": {
                  "text": "Function '{0}' was matched by a model but is not present in the index, so its source/sink endpoints were dropped."
                }
              },
              "name": "Endpoint function not indexed",
              "shortDescription": {
                "text": "A matched function name is absent from the index"
              }
            },
            {
              "id": "CTADL0006.no-sources-matched",
              "messageStrings": {
                "default": {
                  "text": "{0} source port(s) were declared but none of them matched anything in the program, so no taint could be seeded."
