          "name": "ctadl",
          "notifications": [
            {
              "id": "CTADL0001.no-endpoints-configured",
              "messageStrings": {
                "default": {
                  "text": "No taint sources or sinks were configured ({0} model file(s) loaded, no built-in endpoints), so the query has nothing to search for."
                }
              },
              "name": "No endpoints configured",
              "shortDescription": {
                "text": "Neither a source nor a sink was declared anywhere"
              }
            },
            {
              "id": "CTADL0002.no-sources-configured",
              "messageStrings": {
                "default": {
                  "text": "No taint sources were configured, but {0} sink endpoint(s) were. A taint query with no source is vacuous."
                }
              },
              "name": "No sources configured",
              "shortDescription": {
                "text": "Sinks were declared but no source was"
              }
            },
            {
              "id": "CTADL0003.no-sinks-configured",
              "messageStrings": {
                "default": {
                  "text": "No taint sinks were configured, but {0} source endpoint(s) were. A taint query with no sink is vacuous."
                }
              },
              "name": "No sinks configured",
              "shortDescription": {
                "text": "Sources were declared but no sink was"
              }
            },
            {
              "id": "CTADL0004.generator-matched-nothing",
              "messageStrings": {
                "default": {
                  "text": "Model generator {0} in '{1}' declares a {2} that matched nothing in the program, so it contributes nothing to the query."
                },
                "indexTimeDeclaration": {
                  "text": "Model generator {0} in '{1}' declares a {2}, but no function in the program matched its 'where' constraints, so it will contribute nothing when the project is indexed."
                },
                "localNotFound": {
                  "text": "Model generator {0} in '{1}' declares a {2} on port 'Variable({3})': its 'where' constraints matched {4} function(s), but none of them has a local variable named '{3}', so it contributes nothing to the query."
                },
                "mixedReasons": {
                  "text": "Model generator {0} in '{1}' declares {3} {2} port(s), none of which matched anything in the program ({4}), so it contributes nothing to the query."
                },
                "noCallerMatched": {
                  "text": "Model generator {0} in '{1}' declares a {2} at call sites: its 'where' constraints matched {3} function(s), but no caller of them satisfied its 'in_function' constraint, so it contributes nothing to the query."
                },
                "noFunctionMatched": {
                  "text": "Model generator {0} in '{1}' declares a {2}, but no function in the program matched its 'where' constraints, so it contributes nothing to the query."
                },
                "portRejected": {
                  "text": "Model generator {0} in '{1}' declares a {2} on a port that is not valid for its 'find' method, so it contributes nothing to the query."
                }
              },
              "name": "Model generator matched nothing",
              "shortDescription": {
                "text": "A model generator declared a port that produced no endpoint"
              }
            },
            {
              "id": "CTADL0005.endpoint-function-not-indexed",
              "messageStrings": {
                "default": {
                  "text": "Function '{0}' was matched by a model but is not present in the index, so its source/sink endpoints were dropped."
                }
              },
              "name": "Endpoint function not indexed",
              "shortDescription": {
                "text": "A matched function name is absent from the index"
              }
            },
            {
              "id": "CTADL0006.no-sources-matched",
              "messageStrings": {
                "default": {
                  "text": "{0} source port(s) were declared but none of them matched anything in the program, so no taint could be seeded."
                }
              },
              "name": "No sources matched",
              "shortDescription": {
                "text": "Sources were declared but none matched the program"
              }
            },
            {
              "id": "CTADL0007.no-sinks-matched",
              "messageStrings": {
                "default": {
                  "text": "{0} sink port(s) were declared but none of them matched anything in the program, so no flow could be detected."
                }
              },
              "name": "No sinks matched",
              "shortDescription": {
                "text": "Sinks were declared but none matched the program"
              }
            },
            {
              "id": "CTADL0008.no-index-model-check-only",
              "messageStrings": {
                "default": {
                  "text": "The project has no index, so no taint analysis ran. The model files were matched against the imported program(s) instead -- {0} -- and the notifications below report what they select. These are model-matching results only: call-site fan-out, 'Argument(*)' expansion and sink wildcard expansion need the index, a matched name can still be absent from it, and bridge pairs are not counted. Run `ctadl index` for a real query."
                }
              },
              "name": "No index; model check only",
              "shortDescription": {
                "text": "The project has no index, so only the model files were checked"
              }
            },
            {
              "id": "CTADL0009.generator-scope-excluded",
              "messageStrings": {
                "default": {
                  "text": "Model generator {0} in '{1}' has an 'in' scope ({2}) that admits none of the programs checked, so it was never evaluated against any of them."
                }
              },
              "name": "Model generator out of scope",
              "shortDescription": {
                "text": "A generator's 'in' clause admits none of the programs checked"
              }
            },
            {
              "id": "CTADL0010.bridge-model-diagnosis",
              "messageStrings": {
                "default": {
                  "text": "Model generator {0} in '{1}': {2}"
                }
              },
              "name": "Bridge model cannot be paired",
              "shortDescription": {
                "text": "A bridge's sides matched nothing, or matched ambiguously"
              }
            },
            {
              "id": "CTADL0011.generator-matched",
              "messageStrings": {
                "default": {
                  "text": "Model generator {0} in '{1}' matched {2}{3}."
                }
              },
              "name": "Model generator matched",
              "shortDescription": {
                "text": "What a generator's 'where' constraints selected"
              }
            },
            {
              "id": "CTADL0012.model-file-error",
              "messageStrings": {
                "default": {
                  "text": "Model file '{0}': {1}"
                }
              },
              "name": "Model file error",
              "shortDescription": {
                "text": "A model file could not be read, or a generator in it is malformed"
              }
            },
            {
              "id": "CTADL0100.endpoint-match-summary",
              "messageStrings": {
                "default": {
                  "text": "Declared {0} source and {1} sink port(s), which matched {2} source and {3} sink endpoint(s) in the program; {4} declared port(s) matched nothing."
                },
                "modelCheckOnly": {
                  "text": "Declared {0} source and {1} sink port(s), which matched {2} source and {3} sink model row(s) in the program(s) checked -- before the call-site fan-out and wildcard expansion an index would apply; {4} declared port(s) matched nothing."
                }
              },
              "name": "Endpoint match summary",
              "shortDescription": {
                "text": "How many ports the models declared and how many endpoints they matched"
              }
            },
            {
