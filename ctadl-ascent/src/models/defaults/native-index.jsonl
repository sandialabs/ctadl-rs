// Default propagation models for native frontends (VirtualMethodTable::Native -- pcode today).
//
// Propagation only. CTADL ships no default sources or sinks: `cli::index` uses only the
// `summary` half of a loaded model batch, so the `sources`/`sinks` entries this file used to
// carry were parsed, validated, and discarded on every index. Their presence implied CTADL
// ships default endpoints, which it does not. Three generators here were endpoints and nothing
// else (`fgets`/`getenv`/... sources, `read`/`fread`/... sources, `system`/`exec*` sinks); they
// went with the entries.
//
// `.deref` is an ordinary symbol segment -- pcode's spelling for a pointee -- so it behaves as
// written. `.[<n>]` is a real `PathSegment::Offset` and matches what pcode emits; a field whose
// *name* begins with `[` would have to be escaped (`.\[...]`), which pcode never needs.
{"find":"methods","where":[{"constraint":"signature_match","names":["strcpy","wcscpy","strncpy","wcsncpy","stpcpy","wcpcpy","stpncpy","wcpncpy","strcat","wcscat","strncat","wcsncat"]}],"model":{"propagation":[{"input":"Argument(1).deref","output":"Argument(0).deref"},{"input":"Argument(1).deref","output":"Return.deref"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["memcpy","memmove","mempcpy","memccpy","bcopy"]}],"model":{"propagation":[{"input":"Argument(1).deref","output":"Argument(0).deref"},{"input":"Argument(1).deref","output":"Return.deref"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["sprintf","swprintf","snprintf","vsprintf","vsnprintf","vswprintf","asprintf","vasprintf"]}],"model":{"propagation":[{"input":"Argument(*).deref","output":"Argument(0).deref"},{"input":"Argument(*).deref","output":"Return.deref"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["sscanf","swscanf","vsscanf","vswscanf"]}],"model":{"propagation":[{"input":"Argument(0).deref","output":"Argument(*).deref"},{"input":"Argument(0).deref","output":"Return.deref"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["strdup","strndup","wcsdup"]}],"model":{"propagation":[{"input":"Argument(0).deref","output":"Return.deref"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["strchr","strrchr","wcschr","wcsrchr","strpbrk","wcspbrk","strstr","wcsstr","strtok","wcstok","strsep"]}],"model":{"propagation":[{"input":"Argument(0).deref","output":"Return.deref"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["strlen","wcslen","strnlen","wcsnlen"]}],"model":{"propagation":[{"input":"Argument(0).deref","output":"Return"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["atoi","atol","atoll","atof","strtol","strtoll","strtoul","strtoull","strtof","strtod","strtold","wcstol","wcstoll","wcstoul","wcstoull","wcstof","wcstod","wcstold"]}],"model":{"propagation":[{"input":"Argument(0).deref","output":"Return"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["bsearch","lsearch","lfind"]}],"model":{"propagation":[{"input":"Argument(1).deref","output":"Return.deref"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["qsort","heapsort","mergesort"]}],"model":{"propagation":[{"input":"Argument(0).deref","output":"Argument(0).deref"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["malloc","calloc","realloc","reallocarray","aligned_alloc","valloc","memalign","posix_memalign"]}],"model":{"propagation":[{"input":"Argument(*)","output":"Return.deref"}]}}
