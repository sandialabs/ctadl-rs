propagation(F::return."<[System.Private.CoreLib]System.ValueTuple`4::Item1>" <- F::arg(0)),
  propagation(F::return."<[System.Private.CoreLib]System.ValueTuple`4::Item2>" <- F::arg(1)),
  propagation(F::return."<[System.Private.CoreLib]System.ValueTuple`4::Item3>" <- F::arg(2)),
  propagation(F::return."<[System.Private.CoreLib]System.ValueTuple`4::Item4>" <- F::arg(3)) :-
  fun(F, name = "Create``4", parent = "[System.Private.CoreLib]System.ValueTuple");

propagation(F::arg(0) <- F::arg(1)),
  propagation(F::arg(0) <- F::arg(2)),
  propagation(F::arg(0) <- F::arg(3)),
  propagation(F::arg(0) <- F::arg(4)) :-
  fun(F, name = ".ctor", parent = "[System.Private.CoreLib]System.Tuple`4");

propagation(F::return <- F::arg(0)) :-
  fun(F, name in {"get_Item1", "get_Item2", "get_Item3", "get_Item4", "ToString"}, parent = "[System.Private.CoreLib]System.Tuple`4");

// ============================================================================================
// DISPATCH MODELS (`K::dispatch(...)`). The Java file's section of the same name says what these
// are and what they cost: a model attaches to a CALL SITE's static signature and REPLACES the
// site's target set, so every entry is a contract, fixed by the interface it implements rather than
// by which implementation runs. Here `parent` is the class a `callvirt` names, which is the
// method's original declaration: C# calls an override through `System.Object::ToString`, an
// interface method through the interface. A call that cannot dispatch (not virtual, final, sealed,
// or constrained to a value type) is a direct call and never reaches these.
//
// A constrained call on a type parameter passes the receiver by address, so the Object contract
// reads `arg(0).deref` as well as `arg(0)`; for a class receiver that port is empty.
// ---- the Object contract ----
K::dispatch(return <- arg(_)),
  K::dispatch(return <- arg(0).deref) :-
  callsig(K, name = "ToString"),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(\\)->System\\.String$");

// GetHashCode and Equals are models, not skips, as in Java. Equals is any one-parameter overload:
// a C# record and an IEquatable<T> implementation declare `Equals(T)` beside `Equals(object)`.
K::dispatch(return <- arg(_)),
  K::dispatch(return <- arg(0).deref) :-
  callsig(K, name = "GetHashCode"),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(\\)->System\\.Int32$");

K::dispatch(return <- arg(_)),
  K::dispatch(return <- arg(0).deref) :-
  callsig(K, name = "Equals"),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\([^,]+\\)->System\\.Boolean$");

// An equality comparer is the same contract, with the receiver as an argument.
K::dispatch(return <- arg(_)) :-
  callsig(K, name in {"Equals", "GetHashCode"}, parent in {"[System.Private.CoreLib]System.Collections.IEqualityComparer", "[System.Private.CoreLib]System.Collections.Generic.IEqualityComparer`1", "[System.Private.CoreLib]System.Collections.Generic.EqualityComparer`1"});

// ---- the container contract, element-level so reads and writes compose ----
// The ports are the `propagation` rules' above. Only interfaces and the non-generic collections,
// whose methods are virtual, are named: `List<T>` and `Dictionary<K,V>` calls are direct.
K::dispatch(return <- arg(0)."[]") :-
  callsig(K, name = "get_Item", parent in {"[System.Private.CoreLib]System.Collections.Generic.IList`1", "[System.Private.CoreLib]System.Collections.Generic.IReadOnlyList`1", "[System.Private.CoreLib]System.Collections.IList", "[System.Private.CoreLib]System.Collections.Generic.IDictionary`2", "[System.Private.CoreLib]System.Collections.Generic.IReadOnlyDictionary`2", "[System.Private.CoreLib]System.Collections.IDictionary", "[System.Private.CoreLib]System.Collections.ArrayList", "[System.Private.CoreLib]System.Collections.Hashtable"});

K::dispatch(arg(0)."[]" <- arg(1)),
  K::dispatch(arg(0)."[]" <- arg(2)) :-
  callsig(K, name in {"Add", "Insert", "set_Item"}, parent in {"[System.Private.CoreLib]System.Collections.Generic.ICollection`1", "[System.Private.CoreLib]System.Collections.Generic.IList`1", "[System.Private.CoreLib]System.Collections.IList", "[System.Private.CoreLib]System.Collections.Generic.ISet`1", "[System.Private.CoreLib]System.Collections.Generic.IDictionary`2", "[System.Private.CoreLib]System.Collections.IDictionary", "[System.Private.CoreLib]System.Collections.ArrayList", "[System.Private.CoreLib]System.Collections.Hashtable"});

K::dispatch(arg(2).deref <- arg(0)."[]") :-
  callsig(K, name = "TryGetValue", parent in {"[System.Private.CoreLib]System.Collections.Generic.IDictionary`2", "[System.Private.CoreLib]System.Collections.Generic.IReadOnlyDictionary`2"}),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "&\\)");

// Views and copies share the elements at the same level, so a bare port is exactly right.
K::dispatch(return <- arg(0)) :-
  callsig(K, name in {"get_Keys", "get_Values"}, parent in {"[System.Private.CoreLib]System.Collections.Generic.IDictionary`2", "[System.Private.CoreLib]System.Collections.Generic.IReadOnlyDictionary`2", "[System.Private.CoreLib]System.Collections.IDictionary", "[System.Private.CoreLib]System.Collections.Hashtable"});

K::dispatch(arg(1) <- arg(0)),
  K::dispatch(arg(2) <- arg(0)) :-
  callsig(K, name = "CopyTo", parent in {"[System.Private.CoreLib]System.Collections.Generic.ICollection`1", "[System.Private.CoreLib]System.Collections.ICollection", "[System.Private.CoreLib]System.Collections.ArrayList", "[System.Private.CoreLib]System.Collections.Hashtable"});

// ---- discards: `resolve = "skip"` means "this call moves nothing" ----
// As in Java: the shortest list, keyed on the contract by name, descriptor and declaring type, and
// every output a primitive derived from the receiver's shape. Unlike Java, Compare and CompareTo are
// not skipped: a comparer is program code that may keep what it compares (nightly/tests/cil
// overrides.cs, `FirstWins`), and a skip would drop that body with no model in its place.
K::dispatch(resolve = "skip") :-
  callsig(K, name = "get_Count", parent in {"[System.Private.CoreLib]System.Collections.Generic.ICollection`1", "[System.Private.CoreLib]System.Collections.Generic.IReadOnlyCollection`1", "[System.Private.CoreLib]System.Collections.ICollection", "[System.Private.CoreLib]System.Collections.ArrayList", "[System.Private.CoreLib]System.Collections.Hashtable"}),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(\\)->System\\.Int32$");

K::dispatch(resolve = "skip") :-
  callsig(K, name in {"Contains", "ContainsKey", "ContainsValue"}, parent in {"[System.Private.CoreLib]System.Collections.Generic.ICollection`1", "[System.Private.CoreLib]System.Collections.IList", "[System.Private.CoreLib]System.Collections.IDictionary", "[System.Private.CoreLib]System.Collections.Generic.IDictionary`2", "[System.Private.CoreLib]System.Collections.Generic.IReadOnlyDictionary`2", "[System.Private.CoreLib]System.Collections.ArrayList", "[System.Private.CoreLib]System.Collections.Hashtable"}),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "->System\\.Boolean$");

K::dispatch(resolve = "skip") :-
  callsig(K, name in {"IndexOf", "LastIndexOf"}, parent in {"[System.Private.CoreLib]System.Collections.Generic.IList`1", "[System.Private.CoreLib]System.Collections.IList", "[System.Private.CoreLib]System.Collections.ArrayList"}),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "->System\\.Int32$");

// ---- resource release and iteration: hybrid inlining, not a model ----
// Resource release for the Java file's reasons: a Dispose or Close body is where buffered data
// reaches a file or a socket. Iteration because most enumerators are compiler-generated `yield`
// state machines, and an iterator's own body, with any source or sink in it, runs inside MoveNext.
K::dispatch(resolve = "inline") :-
  callsig(K, name in {"Dispose", "DisposeAsync", "Close", "Flush", "FlushAsync"}, parent in {"[System.Private.CoreLib]System.IDisposable", "[System.Private.CoreLib]System.IAsyncDisposable", "[System.Private.CoreLib]System.IO.Stream", "[System.Private.CoreLib]System.IO.TextReader", "[System.Private.CoreLib]System.IO.TextWriter", "[System.Private.CoreLib]System.IO.BinaryReader", "[System.Private.CoreLib]System.IO.BinaryWriter"});

K::dispatch(resolve = "inline") :-
  callsig(K, name in {"MoveNext", "MoveNextAsync"}, parent in {"[System.Private.CoreLib]System.Collections.IEnumerator", "[System.Private.CoreLib]System.Collections.Generic.IAsyncEnumerator`1"});

// GetEnumerator and Current are inlined too, since an iterator's Current reads a generated field, not
// `."[]"`. But a library collection's enumerator has no method in the import for inlining to find, so
// these also carry the `propagation` rules' summary: a `foreach` over a parameter that holds a
// List<T> or an array keeps its elements.
K::dispatch(resolve = "inline", return <- arg(0)) :-
  callsig(K, name = "GetEnumerator", parent in {"[System.Private.CoreLib]System.Collections.Generic.IEnumerable`1", "[System.Private.CoreLib]System.Collections.IEnumerable"});

K::dispatch(resolve = "inline", return <- arg(0)."[]") :-
  callsig(K, name = "get_Current", parent in {"[System.Private.CoreLib]System.Collections.Generic.IEnumerator`1", "[System.Private.CoreLib]System.Collections.IEnumerator"});
