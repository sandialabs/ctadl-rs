// Default propagation models for the .NET frontend (VirtualMethodTable::Cil -- `ctadl import -l cil`).
// Propagation only; CTADL ships no default sources or sinks. Each entry is checked against .NET itself
// by `cargo xtask regression --frontend cil` (`cil:models`, xtask/src/cil/models.rs), which calls every
// overload a rule matches with marked arguments and fails on a flow no model covers. A
// `dispatch` rule, at the end, is checked only to select a method .NET has.
//
// NAMES. `parent` is the class DECLARED AT THE CALL SITE, spelled as the frontend spells it
// (frontends/ctadl-cil/src/names.rs): `[Asm]Ns.Type`, generic arity kept, nested `Outer/Inner`,
// and the assembly the type is DEFINED in, after forwarders -- `[System.Private.CoreLib]System.String`,
// never `[System.Runtime]` or `[mscorlib]`. The frontend canonicalizes through the shared framework of
// the `dotnet` on PATH (or $CTADL_CIL_REFERENCE_DIRS), so a .NET Framework or Mono assembly's calls land
// on these spellings too; `cil:models` fails a class that has moved. A call through an interface is
// declared on the interface, so containers list their interfaces beside the concrete types.
//
// PORTS. `arg(0)` is the receiver of an instance method and the new object of a constructor;
// a static method's first parameter is `arg(0)`. Three path segments matter:
// - `."[]"` is an element: of an array, of a collection, of a dictionary (keys and values alike).
//   A write `arg(0)."[]" <- ...` and a read `return <- arg(0)."[]"` are the two halves of one
//   prefix substitution, so they compose; a bare port carries the element level along with it.
// - `.deref` is what a pointer points at. A STRUCT receiver arrives as a pointer (`ldloca; call`),
//   and so does a `ref`/`out` parameter: `int.ToString()` reads
//   `arg(0).deref`, `TryGetValue(k, out v)` writes `arg(2).deref`, and a struct
//   constructor writes `arg(0).deref`.
// - Nothing else. A library type's own fields are invisible to the analysis, so its contents ARE the
//   object: a `StringBuilder`, a `Uri`, a reader. ValueTuple is the exception, because C# reads its
//   public fields directly.
// Overloads that differ in where the data is (a `String` or a `String[]`) are split by a
// `regex_match` over the signature, e.g. `(System.String[])->System.String`.

// ---- System.Object ----
propagation(F::return <- F::arg(0)) :-
  fun(F, name = "ToString", parent = "[System.Private.CoreLib]System.Object");

// ---- System.String ----
// Element overloads of Concat/Join take an array or a sequence; the rest take the strings themselves.
propagation(F::return <- F::arg(0)."[]") :-
  fun(F, name in {"Concat", "Concat``1"}, parent = "[System.Private.CoreLib]System.String"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "^\\((System\\.String\\[\\]|System\\.Object\\[\\]|System\\.Collections\\.Generic\\.IEnumerable`1<[^>]*>)\\)");

propagation(F::return <- F::arg(_)) :-
  fun(F, name = "Concat", parent = "[System.Private.CoreLib]System.String"),
  !(fun(F, signature = Sig0) && regex_match(Sig0, "^\\((System\\.String\\[\\]|System\\.Object\\[\\]|System\\.Collections\\.Generic\\.IEnumerable`1<[^>]*>)\\)|^\\(System\\.ReadOnlySpan`1<System\\.Char>"));

// A string's characters are elements when it is taken apart, as ToCharArray, a span, a memory or
// an enumerator over it take it, and are read back as elements.
propagation(F::return <- F::arg(0)."[]"),
  propagation(F::return <- F::arg(1)."[]"),
  propagation(F::return <- F::arg(2)."[]"),
  propagation(F::return <- F::arg(3)."[]") :-
  fun(F, name = "Concat", parent = "[System.Private.CoreLib]System.String"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "^\\(System\\.ReadOnlySpan`1<System\\.Char>");

propagation(F::return <- F::arg(0)),
  propagation(F::return <- F::arg(1)."[]") :-
  fun(F, name in {"Join", "Join``1"}, parent = "[System.Private.CoreLib]System.String");

propagation(F::return <- F::arg(0)),
  propagation(F::return <- F::arg(1)."[]") :-
  fun(F, name = "Format", parent = "[System.Private.CoreLib]System.String"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "^\\(System\\.String,System\\.Object\\[\\]\\)");

propagation(F::return <- F::arg(1)),
  propagation(F::return <- F::arg(2)."[]") :-
  fun(F, name = "Format", parent = "[System.Private.CoreLib]System.String"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "^\\(System\\.IFormatProvider,System\\.String,System\\.Object\\[\\]\\)");

propagation(F::return <- F::arg(_)) :-
  fun(F, name in {"Format", "Format``1", "Format``2", "Format``3"}, parent = "[System.Private.CoreLib]System.String"),
  !(fun(F, signature = Sig0) && regex_match(Sig0, "System\\.Object\\[\\]\\)"));

propagation(F::return <- F::arg(0)) :-
  fun(F, name in {"Substring", "Trim", "TrimStart", "TrimEnd", "ToUpper", "ToLower", "ToUpperInvariant", "ToLowerInvariant", "PadLeft", "PadRight", "Normalize", "Remove", "ToString", "Clone", "get_Chars", "Copy", "Intern", "IsInterned"}, parent = "[System.Private.CoreLib]System.String");

propagation(F::return <- F::arg(0)),
  propagation(F::return <- F::arg(2)) :-
  fun(F, name in {"Insert", "Replace", "ReplaceLineEndings"}, parent = "[System.Private.CoreLib]System.String");

propagation(F::return."[]" <- F::arg(0)) :-
  fun(F, name in {"Split", "ToCharArray", "GetEnumerator", "EnumerateRunes"}, parent = "[System.Private.CoreLib]System.String");

propagation(F::return <- F::arg(0)."[]") :-
  fun(F, name = "get_Current", parent = "[System.Private.CoreLib]System.CharEnumerator");

propagation(F::arg(2)."[]" <- F::arg(0)) :-
  fun(F, name = "CopyTo", parent = "[System.Private.CoreLib]System.String"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "Char\\[\\]");

propagation(F::arg(0) <- F::arg(1)."[]") :-
  fun(F, name = ".ctor", parent = "[System.Private.CoreLib]System.String"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "^\\(System\\.(Char\\[\\]|ReadOnlySpan`1)");

propagation(F::arg(0) <- F::arg(1)) :-
  fun(F, name = ".ctor", parent = "[System.Private.CoreLib]System.String"),
  !(fun(F, signature = Sig0) && regex_match(Sig0, "^\\(System\\.(Char\\[\\]|ReadOnlySpan`1)"));

// ---- System.Text.StringBuilder ----
// A builder's contents are the builder. The writers return the builder itself, so the receiver flows
// to the result too; but no model can say the result IS the receiver, so a chain whose result is
// dropped (`sb.Append(a).Append(src); sb.ToString()`) taints only the first link's result, not `sb`,
// as with the Java models. Array, sequence, span and memory overloads read their argument's elements.
propagation(F::return <- F::arg(0)),
  propagation(F::arg(0) <- F::arg(1)),
  propagation(F::arg(0) <- F::arg(2)),
  propagation(F::arg(0) <- F::arg(3)),
  propagation(F::arg(0) <- F::arg(4)),
  propagation(F::return <- F::arg(1)),
  propagation(F::return <- F::arg(2)),
  propagation(F::return <- F::arg(3)),
  propagation(F::return <- F::arg(4)) :-
  fun(F, name in {"Append", "AppendLine", "AppendFormat", "AppendFormat``1", "AppendFormat``2", "AppendFormat``3", "AppendJoin", "AppendJoin``1", "Insert", "Replace"}, parent = "[System.Private.CoreLib]System.Text.StringBuilder"),
  !(fun(F, signature = Sig0) && regex_match(Sig0, "\\[\\]|IEnumerable|Memory`1|Span`1"));

propagation(F::return <- F::arg(0)),
  propagation(F::arg(0) <- F::arg(1)),
  propagation(F::arg(0) <- F::arg(1)."[]"),
  propagation(F::return <- F::arg(1)),
  propagation(F::return <- F::arg(1)."[]"),
  propagation(F::arg(0) <- F::arg(2)),
  propagation(F::arg(0) <- F::arg(2)."[]"),
  propagation(F::return <- F::arg(2)),
  propagation(F::return <- F::arg(2)."[]"),
  propagation(F::arg(0) <- F::arg(3)),
  propagation(F::arg(0) <- F::arg(3)."[]"),
  propagation(F::return <- F::arg(3)),
  propagation(F::return <- F::arg(3)."[]") :-
  fun(F, name in {"Append", "AppendLine", "AppendFormat", "AppendFormat``1", "AppendFormat``2", "AppendFormat``3", "AppendJoin", "AppendJoin``1", "Insert", "Replace"}, parent = "[System.Private.CoreLib]System.Text.StringBuilder"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "\\[\\]|IEnumerable|Memory`1|Span`1");

propagation(F::return <- F::arg(0)) :-
  fun(F, name in {"ToString", "get_Chars"}, parent = "[System.Private.CoreLib]System.Text.StringBuilder");

propagation(F::arg(2)."[]" <- F::arg(0)) :-
  fun(F, name = "CopyTo", parent = "[System.Private.CoreLib]System.Text.StringBuilder"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "Char\\[\\]");

propagation(F::arg(0) <- F::arg(1)) :-
  fun(F, name = ".ctor", parent = "[System.Private.CoreLib]System.Text.StringBuilder");

// `sb.Append($"...")` builds through a handler that writes into the builder it was made with, and
// the Append that takes the handler hands the result back.
propagation(F::arg(0).deref <- F::arg(3)) :-
  fun(F, name = ".ctor", parent = "[System.Private.CoreLib]System.Text.StringBuilder/AppendInterpolatedStringHandler");

propagation(F::arg(0).deref <- F::arg(1)) :-
  fun(F, name in {"AppendLiteral", "AppendFormatted", "AppendFormatted``1"}, parent = "[System.Private.CoreLib]System.Text.StringBuilder/AppendInterpolatedStringHandler");

propagation(F::arg(0) <- F::arg(1).deref),
  propagation(F::return <- F::arg(1).deref),
  propagation(F::arg(0) <- F::arg(2).deref),
  propagation(F::return <- F::arg(2).deref) :-
  fun(F, name in {"Append", "AppendLine"}, parent = "[System.Private.CoreLib]System.Text.StringBuilder"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "AppendInterpolatedStringHandler&");

// ---- string interpolation ----
// `$"..{x}.."` compiles to a DefaultInterpolatedStringHandler local: a struct, so every call gets a
// pointer to it. `cil:models` cannot call these (a ref struct cannot be boxed); the Cil:library case
// covers them end to end.
propagation(F::arg(0).deref <- F::arg(1)) :-
  fun(F, name in {"AppendLiteral", "AppendFormatted", "AppendFormatted``1"}, parent = "[System.Private.CoreLib]System.Runtime.CompilerServices.DefaultInterpolatedStringHandler");

propagation(F::return <- F::arg(0).deref) :-
  fun(F, name in {"ToStringAndClear", "ToString"}, parent = "[System.Private.CoreLib]System.Runtime.CompilerServices.DefaultInterpolatedStringHandler");

propagation(F::return <- F::arg(1).deref) :-
  fun(F, name = "Create", parent = "[System.Private.CoreLib]System.String"),
  fun(F, signature = Sig0),
  regex_match(Sig0, "DefaultInterpolatedStringHandler&");

// ---- primitives: parsing and formatting ----
// Parse and TryParse are static; the out parameter is always the last. ToString is an instance method
// on a struct, so it reads through the receiver's pointer.
propagation(F::return <- F::arg(0)) :-
  fun(F, name in {"Parse", "ParseExact"}, parent in {"[System.Private.CoreLib]System.Boolean", "[System.Private.CoreLib]System.Byte", "[System.Private.CoreLib]System.SByte", "[System.Private.CoreLib]System.Char", "[System.Private.CoreLib]System.Int16", "[System.Private.CoreLib]System.UInt16", "[System.Private.CoreLib]System.Int32", "[System.Private.CoreLib]System.UInt32", "[System.Private.CoreLib]System.Int64", "[System.Private.CoreLib]System.UInt64", "[System.Private.CoreLib]System.Single", "[System.Private.CoreLib]System.Double", "[System.Private.CoreLib]System.Decimal", "[System.Private.CoreLib]System.Guid", "[System.Private.CoreLib]System.DateTime", "[System.Private.CoreLib]System.DateTimeOffset", "[System.Private.CoreLib]System.TimeSpan"});

propagation(F::arg(1).deref <- F::arg(0)) :-
  fun(F, name in {"TryParse", "TryParseExact"}, parent in {"[System.Private.CoreLib]System.Boolean", "[System.Private.CoreLib]System.Byte", "[System.Private.CoreLib]System.SByte", "[System.Private.CoreLib]System.Char", "[System.Private.CoreLib]System.Int16", "[System.Private.CoreLib]System.UInt16", "[System.Private.CoreLib]System.Int32", "[System.Private.CoreLib]System.UInt32", "[System.Private.CoreLib]System.Int64", "[System.Private.CoreLib]System.UInt64", "[System.Private.CoreLib]System.Single", "[System.Private.CoreLib]System.Double", "[System.Private.CoreLib]System.Decimal", "[System.Private.CoreLib]System.Guid", "[System.Private.CoreLib]System.DateTime", "[System.Private.CoreLib]System.DateTimeOffset", "[System.Private.CoreLib]System.TimeSpan"}),
