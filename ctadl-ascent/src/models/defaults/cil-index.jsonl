{"find":"methods","where":[{"constraint":"signature_match","names":["Concat"],"parents":["[System.Private.CoreLib]System.String"]},{"constraint":"signature","pattern":"^\\(System\\.ReadOnlySpan`1<System\\.Char>"}],"model":{"propagation":[{"input":"Argument(0).\\[]","output":"Return"},{"input":"Argument(1).\\[]","output":"Return"},{"input":"Argument(2).\\[]","output":"Return"},{"input":"Argument(3).\\[]","output":"Return"}]}}
