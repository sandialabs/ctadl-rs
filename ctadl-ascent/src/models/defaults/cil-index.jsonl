{"find":"methods","where":[{"constraint":"signature_match","names":["Concat","Concat``1"],"parents":["[System.Private.CoreLib]System.String"]},{"constraint":"signature","pattern":"^\\((System\\.String\\[\\]|System\\.Object\\[\\]|System\\.Collections\\.Generic\\.IEnumerable`1<[^>]*>)\\)"}],"model":{"propagation":[{"input":"Argument(0).\\[]","output":"Return"}]}}
{"find":"methods","where":[{"constraint":"signature_match","names":["Concat"],"parents":["[System.Private.CoreLib]System.String"]},{"constraint":"not","inner":{"constraint":"signature","pattern":"^\\((System\\.String\\[\\]|System\\.Object\\[\\]|System\\.Collections\\.Generic\\.IEnumerable`1<[^>]*>)\\)|^\\(System\\.ReadOnlySpan`1<System\\.Char>"}}],"model":{"propagation":[{"input":"Argument(*)","output":"Return"}]}}
