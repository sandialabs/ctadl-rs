// `read()` returns a byte; `read(byte[] b, ...)` fills `b`.
propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."#contents"),
  propagation(F::arg(1).#value <- F::arg(0)),
  propagation(F::arg(1).#value <- F::arg(0)."#contents") :-
  fun(F, name = "read", parent in {"Ljava/io/ByteArrayInputStream;", "Ljava/io/BufferedInputStream;", "Ljava/io/FileInputStream;", "Ljava/io/InputStream;", "Ljava/io/RandomAccessFile;"});

propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."[]") :-
  fun(F, name = "<init>", parent = "Lorg/apache/http/entity/ByteArrayEntity;");

propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."[]") :-
  fun(F, name in {"write", "writeBoolean", "writeByte", "writeBytes", "writeChars", "writeChar", "writeDouble", "writeFloat", "writeInt", "writeLong", "writeShort", "writeUTF", "writeObject"}, parent in {"Ljava/io/RandomAccessFile;", "Ljava/io/OutputStream;", "Ljava/io/FilterOutputStream;", "Ljava/io/BufferedOutputStream;", "Ljava/io/DataOutputStream;", "Ljava/io/ByteArrayOutputStream;", "Ljava/io/PipedOutputStream;", "Ljava/io/ObjectOutputStream;", "Ljava/util/zip/GZIPOutputStream;"});

// A constructor that wraps or converts its argument: a stream over a stream, a string over bytes,
// a boxed number over a string, an exception over its message. What the object holds is derived
// from the argument, and from what the argument holds when it is itself a wrapper.
propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."[]"),
  propagation(F::arg(0).#value <- F::arg(1)."#contents"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."#contents") :-
  fun(F, name = "<init>", parent in {"Ljava/io/BufferedReader;", "Ljava/io/ByteArrayInputStream;", "Ljava/io/ObjectInputStream;", "Ljava/io/File;", "Ljava/io/FileInputStream;", "Ljava/io/InputStreamReader;", "Ljava/lang/String;", "Ljavax/activation/DataHandler;", "Ljava/net/URL;", "Ljava/lang/Integer;", "Ljava/lang/Short;", "Ljava/lang/Long;", "Ljava/lang/Byte;", "Ljava/lang/Float;", "Ljava/lang/Double;", "Ljava/lang/Exception;", "Ljava/lang/Throwable;"});

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "getMessage", parent in {"Ljava/lang/Throwable;", "Ljava/lang/Exception;"});

// An OUTPUT wrapper writes through to the stream it wraps, after it is made, so the link is a
// store, not a flow at construction: the wrapped stream's `."#contents"` is the wrapper's, and a
// later write to the wrapper lands in both. (A wrapper a callee makes and returns is not linked.)
propagation(F::arg(1)."#contents" <- F::arg(0)."#contents") :-
  fun(F, name = "<init>", parent in {"Ljava/io/ObjectOutputStream;", "Ljava/io/BufferedOutputStream;", "Ljava/io/DataOutputStream;", "Ljava/io/FilterOutputStream;", "Ljava/io/PrintStream;", "Ljava/io/PrintWriter;", "Ljava/io/OutputStreamWriter;", "Ljava/io/BufferedWriter;", "Ljava/util/zip/GZIPOutputStream;"});

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "normalize", parent = "Ljava/text/Normalizer;");

propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name in {"parseByte", "parseShort", "parseInt", "parseLong", "parseFloat", "parseDouble", "toHexString", "toBinaryString", "toOctalString"}, parent in {"Ljava/lang/Byte;", "Ljava/lang/Short;", "Ljava/lang/Integer;", "Ljava/lang/Long;", "Ljava/lang/Float;", "Ljava/lang/Double;"});

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name in {"highestOneBit", "numberOfTrailingZeros", "parseLong"}, parent = "Ljava/lang/Long;");

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(1)) :-
  fun(F, name in {"min", "max"}, parent in {"Ljava/lang/Math;", "Ljava/lang/Byte;", "Ljava/lang/Short;", "Ljava/lang/Integer;", "Ljava/lang/Long;", "Ljava/lang/Float;", "Ljava/lang/Double;"});

// `format(String, Object...)` takes its arguments in an array: read the elements too.
propagation(F::return.#value <- F::arg(_)),
  propagation(F::return.#value <- F::arg(_)."[]") :-
  fun(F, name in {"format", "concat", "replaceAll", "replace"}, parent = "Ljava/lang/String;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "toASCII", parent = "Ljava/net/IDN;");

// `arraycopy(src, srcPos, dest, destPos, length)`: the elements themselves move.
propagation(F::arg(2)."[]" <- F::arg(0)."[]"),
  propagation(F::arg(2).#value <- F::arg(0)) :-
  fun(F, name = "arraycopy", parent = "Ljava/lang/System;");

propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name in {"add", "and", "andNot", "divide", "divideAndRemainder", "gcd", "max", "min", "mod", "modInverse", "modPow", "multiply", "or", "xor"}, parent = "Ljava/math/BigInteger;");

propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name = "obtain", parent = "Landroid/os/Message;");

propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name = "create", parent = "Ljava/net/URI;");

// `addFlags` and `setFlags` return `this`.
propagation(F::return <- F::arg(0)),
  propagation(F::return.#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)) :-
  fun(F, name in {"addFlags", "setFlags"}, parent = "Landroid/content/Intent;");

propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name in {"parseIntent", "parseUri"}, parent = "Landroid/content/Intent;");

// `asList` is a view over the array: the same elements, at the same level.
propagation(F::return <- F::arg(0)) :-
  fun(F, name = "asList", parent = "Ljava/util/Arrays;");

propagation(F::return."[]" <- F::arg(0)."[]"),
  propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name in {"copyOf", "copyOfRange"}, parent = "Ljava/util/Arrays;");

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."[]") :-
  fun(F, name = "toString", parent = "Ljava/util/Arrays;");

// The `put` family returns `this`.
propagation(F::return <- F::arg(0)),
  propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."[]"),
  propagation(F::arg(0).#value <- F::arg(2)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(2)) :-
  fun(F, name in {"put", "putChar", "putDouble", "putFloat", "putInt", "putLong", "putShort"}, parent = "Ljava/nio/ByteBuffer;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "unmarshall", parent = "Landroid/os/Parcel;");

propagation(F::return.#value <- F::arg(_)),
  propagation(F::return.#value <- F::arg(_)."[]") :-
  fun(F, name = "createFromPdu", parent in {"Landroid/telephony/SmsMessage;", "Landroid/telephony/gsm/SmsMessage;"});

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."#contents") :-
  fun(F, name = "toByteArray", parent = "Ljava/io/ByteArrayOutputStream;");

propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name = "matcher", parent = "Ljava/util/regex/Pattern;");

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(1)) :-
  fun(F, name = "equalsIgnoreCase", parent = "Ljava/lang/String;");

propagation(F::return <- F::arg(0)) :-
  fun(F, name = "getExtras", parent = "Landroid/content/Intent;");

// `get(key)` and `get(key, defaultValue)`: the value comes out of the bundle, or is the default.
propagation(F::return <- F::arg(0)),
  propagation(F::return.#value <- F::arg(1)),
  propagation(F::return <- F::arg(2)) :-
  fun(F, signature = Sig0),
  regex_match(Sig0, ".*get.*"),
  fun(F, parent = "Landroid/os/Bundle;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "getString", parent = "Landroid/database/Cursor;");

propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."[]") :-
  fun(F, name = "update", parent = "Ljava/security/MessageDigest;");

// `digest()`, and `digest(byte[])`, which updates first.
propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."#contents"),
  propagation(F::return.#value <- F::arg(1)),
  propagation(F::return.#value <- F::arg(1)."[]") :-
  fun(F, name = "digest", parent = "Ljava/security/MessageDigest;");

propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."#contents"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."#contents") :-
  fun(F, name = "setEntity", parent = "Lorg/apache/http/client/methods/HttpPost;");

propagation(F::return."[]" <- F::arg(0)."[]") :-
  fun(F, name = "iterator", parent in {"Ljava/util/Iterable;", "Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/ArrayList;", "Ljava/util/LinkedList;", "Ljava/util/HashSet;", "Ljava/util/TreeSet;"});

propagation(F::return <- F::arg(0)."[]") :-
  fun(F, name = "next", parent = "Ljava/util/Iterator;");

// ---- java.util containers: element-level, so writes and reads compose ----
// A read is `return <- arg(0)."[]"` and a write is `arg(0)."[]" <- ...`, the two
// halves of one prefix substitution. Mixing a bare read with an element-level write (or the
// reverse) silently composes to nothing: the write would put taint one level below where the
// read looks for it. These are object flow: a container hands back the very object put in it.
// Writers carry BOTH `arg(1)` and `arg(2)` because these methods are overloaded on arity --
// `add(E)` and `add(int, E)`, `put(K, V)`, `set(int, E)` -- and a rule matches by name, so it
// sees every overload. `arg(_)` would cover them too but would also add a self-edge
// `arg(0)."[]" <- arg(0)`, which deepens a path every time it fires.
propagation(F::return <- F::arg(0)."[]") :-
  fun(F, name in {"get", "getOrDefault", "remove"}, parent in {"Ljava/util/Map;", "Ljava/util/HashMap;", "Ljava/util/LinkedHashMap;", "Ljava/util/TreeMap;", "Ljava/util/Hashtable;", "Ljava/util/Properties;", "Ljava/util/concurrent/ConcurrentHashMap;"});

propagation(F::arg(0)."[]" <- F::arg(1)),
  propagation(F::arg(0)."[]" <- F::arg(2)) :-
  fun(F, name in {"put", "putIfAbsent"}, parent in {"Ljava/util/Map;", "Ljava/util/HashMap;", "Ljava/util/LinkedHashMap;", "Ljava/util/TreeMap;", "Ljava/util/Hashtable;", "Ljava/util/Properties;", "Ljava/util/concurrent/ConcurrentHashMap;"});

// Views share the map's elements at the same level, so a bare port is exactly right.
propagation(F::return <- F::arg(0)) :-
  fun(F, name in {"keySet", "values", "entrySet"}, parent in {"Ljava/util/Map;", "Ljava/util/HashMap;", "Ljava/util/LinkedHashMap;", "Ljava/util/TreeMap;", "Ljava/util/Hashtable;", "Ljava/util/Properties;", "Ljava/util/concurrent/ConcurrentHashMap;"});

propagation(F::return <- F::arg(0)) :-
  fun(F, name in {"getKey", "getValue"}, parent = "Ljava/util/Map$Entry;");

propagation(F::return <- F::arg(0)."[]") :-
  fun(F, name in {"get", "peek", "poll", "pop", "remove", "getFirst", "getLast", "element"}, parent in {"Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/ArrayList;", "Ljava/util/LinkedList;", "Ljava/util/Vector;", "Ljava/util/Stack;", "Ljava/util/HashSet;", "Ljava/util/TreeSet;", "Ljava/util/ArrayDeque;"});

propagation(F::arg(0)."[]" <- F::arg(1)),
  propagation(F::arg(0)."[]" <- F::arg(2)) :-
  fun(F, name in {"add", "push", "offer", "addFirst", "addLast", "set"}, parent in {"Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/ArrayList;", "Ljava/util/LinkedList;", "Ljava/util/Vector;", "Ljava/util/Stack;", "Ljava/util/HashSet;", "Ljava/util/TreeSet;", "Ljava/util/ArrayDeque;"});

// `addAll(c)` and `addAll(int, c)` add `c`'s elements, not `c`.
propagation(F::arg(0)."[]" <- F::arg(1)."[]"),
  propagation(F::arg(0)."[]" <- F::arg(2)."[]") :-
  fun(F, name = "addAll", parent in {"Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/ArrayList;", "Ljava/util/LinkedList;", "Ljava/util/Vector;", "Ljava/util/Stack;", "Ljava/util/HashSet;", "Ljava/util/TreeSet;", "Ljava/util/ArrayDeque;"});

// Bulk views are collections over the same elements: bare, so the element level rides along.
propagation(F::return <- F::arg(0)) :-
  fun(F, name in {"toArray", "subList", "stream"}, parent in {"Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/ArrayList;", "Ljava/util/LinkedList;", "Ljava/util/Vector;", "Ljava/util/Stack;", "Ljava/util/HashSet;", "Ljava/util/TreeSet;", "Ljava/util/ArrayDeque;"});

propagation(F::return <- F::arg(0)) :-
  fun(F, name in {"unmodifiableList", "unmodifiableMap", "unmodifiableSet", "unmodifiableCollection"}, parent = "Ljava/util/Collections;");

propagation(F::return."[]" <- F::arg(0)) :-
  fun(F, name in {"singletonList", "singleton"}, parent = "Ljava/util/Collections;");

// `nCopies(int n, T o)`.
propagation(F::return."[]" <- F::arg(1)) :-
  fun(F, name = "nCopies", parent = "Ljava/util/Collections;");

propagation(F::return <- F::arg(0)) :-
  fun(F, name = "stream", parent = "Ljava/util/Arrays;");

// ---- text ----
// `join(delimiter, elements...)` and `join(delimiter, Iterable)` read the elements.
propagation(F::return.#value <- F::arg(_)),
  propagation(F::return.#value <- F::arg(_)."[]") :-
  fun(F, name in {"join", "copyValueOf", "strip", "stripLeading", "stripTrailing", "repeat", "intern"}, parent = "Ljava/lang/String;");

// Mutators return `this`. The replacement text of `replace(int, int, String)` is `arg(3)`.
propagation(F::return <- F::arg(0)),
  propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(2)),
  propagation(F::arg(0).#value <- F::arg(3)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(2)),
  propagation(F::arg(0)."#contents".#value <- F::arg(3)) :-
  fun(F, name in {"reverse", "deleteCharAt", "replace", "setCharAt"}, parent in {"Ljava/lang/StringBuilder;", "Ljava/lang/StringBuffer;"});

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."#contents") :-
  fun(F, name = "substring", parent in {"Ljava/lang/StringBuilder;", "Ljava/lang/StringBuffer;"});

// ---- codecs: a decode is as much a propagation as an encode ----
propagation(F::return.#value <- F::arg(1)),
  propagation(F::return.#value <- F::arg(1)."[]") :-
  fun(F, name in {"encode", "encodeToString", "decode"}, parent in {"Ljava/util/Base64$Encoder;", "Ljava/util/Base64$Decoder;"});

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."[]") :-
  fun(F, name in {"encode", "encodeToString", "decode", "decodeToString"}, parent = "Landroid/util/Base64;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name in {"encode", "decode"}, parent in {"Ljava/net/URLEncoder;", "Ljava/net/URLDecoder;"});

// ---- readers, writers, properties ----
propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."#contents") :-
  fun(F, name in {"next", "nextLine", "nextInt", "nextLong", "nextDouble", "nextBoolean"}, parent = "Ljava/util/Scanner;");

propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."#contents"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."#contents") :-
  fun(F, name = "<init>", parent = "Ljava/util/Scanner;");

// `Properties` is a map: element-level, like the java.util maps. `getProperty(key, default)`
// may return the default; `load` parses elements out of a stream or reader.
propagation(F::return <- F::arg(0)."[]"),
  propagation(F::return.#value <- F::arg(1)),
  propagation(F::return <- F::arg(2)) :-
  fun(F, name = "getProperty", parent = "Ljava/util/Properties;");

propagation(F::arg(0)."[]" <- F::arg(1)),
  propagation(F::arg(0)."[]" <- F::arg(2)) :-
  fun(F, name = "setProperty", parent = "Ljava/util/Properties;");

propagation(F::arg(0)."[]".#value <- F::arg(1)),
  propagation(F::arg(0)."[]".#value <- F::arg(1)."#contents") :-
  fun(F, name = "load", parent = "Ljava/util/Properties;");

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."#contents") :-
  fun(F, name in {"readAllBytes", "readNBytes", "lines"}, parent in {"Ljava/io/InputStream;", "Ljava/io/Reader;", "Ljava/io/BufferedReader;", "Ljava/io/InputStreamReader;"});

// `printf`, `format` and `append` return `this`. `printf(fmt, args...)` and
// `printf(locale, fmt, args...)` take their arguments in an array.
propagation(F::return <- F::arg(0)),
  propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."[]"),
  propagation(F::arg(0).#value <- F::arg(2)),
  propagation(F::arg(0).#value <- F::arg(2)."[]"),
  propagation(F::arg(0).#value <- F::arg(3)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(2)),
  propagation(F::arg(0)."#contents".#value <- F::arg(2)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(3)."[]") :-
  fun(F, name in {"print", "println", "printf", "format", "append", "write"}, parent in {"Ljava/io/PrintStream;", "Ljava/io/PrintWriter;", "Ljava/io/Writer;", "Ljava/io/BufferedWriter;", "Ljava/io/OutputStreamWriter;"});

propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."#contents"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."#contents") :-
  fun(F, name = "<init>", parent in {"Ljava/util/zip/GZIPInputStream;", "Ljava/util/zip/InflaterInputStream;", "Ljava/util/zip/ZipInputStream;"});

// ---- serialization ----
// org.json is a container, element-level like java.util's maps: `put(key, value)`,
// `put(value)` and `put(index, value)` store an element and return `this`; a getter hands one
// back, and its key or index contributes only taint. `optString(key, fallback)` may return the
// fallback.
propagation(F::return <- F::arg(0)),
  propagation(F::arg(0)."[]" <- F::arg(1)),
  propagation(F::arg(0)."[]" <- F::arg(2)) :-
  fun(F, name = "put", parent in {"Lorg/json/JSONObject;", "Lorg/json/JSONArray;"});

propagation(F::return <- F::arg(0)."[]"),
  propagation(F::return.#value <- F::arg(1)) :-
  fun(F, name in {"get", "getJSONObject", "getJSONArray", "getString", "opt", "optJSONObject", "optJSONArray", "optString"}, parent in {"Lorg/json/JSONObject;", "Lorg/json/JSONArray;"});

propagation(F::return <- F::arg(2)) :-
  fun(F, name = "optString", parent in {"Lorg/json/JSONObject;", "Lorg/json/JSONArray;"});

// `new JSONObject(String)` parses its elements out of the text; `new JSONObject(Map)` and
// `new JSONArray(Collection)` take the elements over.
propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0)."[]".#value <- F::arg(1)),
  propagation(F::arg(0)."[]" <- F::arg(1)."[]") :-
  fun(F, name = "<init>", parent in {"Lorg/json/JSONObject;", "Lorg/json/JSONArray;"});

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."[]") :-
  fun(F, name = "toString", parent in {"Lorg/json/JSONObject;", "Lorg/json/JSONArray;"});

propagation(F::return.#value <- F::arg(1)) :-
  fun(F, name = "toJson", parent = "Lcom/google/gson/Gson;");

// A new object built from the text: taint flow. A field read of the result finds nothing either way.
propagation(F::return.#value <- F::arg(1)) :-
  fun(F, name = "fromJson", parent = "Lcom/google/gson/Gson;");

// ---- misc ----
propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name = "toString", parent = "Ljava/util/Objects;");

// `requireNonNull(obj)` and `requireNonNull(obj, message)` return `obj`; the `Else` forms may
// return their second argument instead.
propagation(F::return <- F::arg(0)) :-
  fun(F, name in {"requireNonNull", "requireNonNullElse", "requireNonNullElseGet"}, parent = "Ljava/util/Objects;");

propagation(F::return <- F::arg(1)) :-
  fun(F, name = "requireNonNullElse", parent = "Ljava/util/Objects;");

propagation(F::return <- F::arg(_)) :-
  fun(F, name in {"of", "ofNullable", "get", "orElse", "orElseGet"}, parent = "Ljava/util/Optional;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "name", parent = "Ljava/lang/Enum;");

// ---- android ----
propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name in {"parse", "toString", "getQueryParameter", "buildUpon", "build"}, parent in {"Landroid/net/Uri;", "Landroid/net/Uri$Builder;"});

// `getString(key, defValue)`: the stored value, or the default itself.
propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(1)),
  propagation(F::return <- F::arg(2)) :-
  fun(F, name in {"getString", "getStringSet"}, parent = "Landroid/content/SharedPreferences;");

// `putString(key, value)` returns the editor.
propagation(F::return <- F::arg(0)),
  propagation(F::arg(0).#value <- F::arg(2)),
  propagation(F::arg(0)."#contents".#value <- F::arg(2)) :-
  fun(F, name in {"putString", "putStringSet"}, parent = "Landroid/content/SharedPreferences$Editor;");

// ============================================================================================
// DISPATCH MODELS (`K::dispatch(...)`). A model here attaches to a CALL SITE's static
// signature, not to a callee, and it REPLACES the site's target set: one summary row instead of
// every implementation CHA can reach. That is what makes it worth having -- `toString` alone is
// about a sixth of a median app's excess call-graph edges -- and it is also its whole risk,
// because the callee bodies leave the analysis along with the edges.
//
// So the list is short and every entry is a CONTRACT: a method whose behaviour is fixed by the
// interface it implements, not by which implementation runs. Anything whose implementations are
// unrelated fragments of the program -- `FunctionN.invoke`, `Runnable.run`, `Provider.get`,
// generated serializers -- is deliberately absent. Those exceed the CHA threshold and fall to
// hybrid inlining by themselves, which is what recovers the receiver's identity.
//
// A model is refused for a signature whose targets hold a matched source or sink, and the site
// takes CHA instead; `ctadl index` says so. Pass the same --models to `index` and `query`.
//
// THE PORTS mean what they mean on a `propagation` head: the receiver is `arg(0)`, the nth
// argument is `arg(n)`, the result is `return`. Most rules below repeat a `propagation` rule
// above as a `dispatch` head on the call signature.
//
// The `Object` models are faithful, not merely cheap. Over 204 named-field writes across all
// four contract methods in two apps, 181 went into an object reached from the receiver's own
// field, 13 into an object allocated in the body, 10 unattributed, and none into an argument or
// a static.
// ---- the Object contract ----
K::dispatch(return.#value <- arg(_)) :-
  callsig(K, name = "toString"),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(\\)Ljava/lang/String;$");

// hashCode and equals are models, not skips: the primitive is derived from the receiver's
// CONTENTS, and a configuration that follows an integer is entitled to. The primitive is
// computed, not handed back, so it is taint flow only.
K::dispatch(return.#value <- arg(_)) :-
  callsig(K, name = "hashCode"),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(\\)I$");

K::dispatch(return.#value <- arg(_)) :-
  callsig(K, name = "equals"),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(Ljava/lang/Object;\\)Z$");

K::dispatch(return <- arg(0)) :-
  callsig(K, name = "clone"),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(\\)Ljava/lang/Object;$");

// ---- the container contract, element-level so reads and writes compose ----
K::dispatch(return <- arg(0)."[]") :-
  callsig(K, name = "next", parent in {"Ljava/util/Iterator;", "Ljava/util/ListIterator;"});

K::dispatch(return."[]" <- arg(0)."[]") :-
  callsig(K, name in {"iterator", "listIterator"}, parent in {"Ljava/lang/Iterable;", "Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/SortedSet;", "Ljava/util/AbstractCollection;", "Ljava/util/AbstractList;", "Ljava/util/AbstractSet;", "Ljava/util/ArrayList;", "Ljava/util/LinkedList;", "Ljava/util/HashSet;", "Ljava/util/TreeSet;", "Ljava/util/Vector;"});

K::dispatch(return <- arg(0)."[]") :-
  callsig(K, name in {"get", "getOrDefault", "remove"}, parent in {"Ljava/util/Map;", "Ljava/util/SortedMap;", "Ljava/util/NavigableMap;", "Ljava/util/AbstractMap;", "Ljava/util/HashMap;", "Ljava/util/LinkedHashMap;", "Ljava/util/TreeMap;", "Ljava/util/Hashtable;", "Ljava/util/EnumMap;", "Ljava/util/WeakHashMap;", "Ljava/util/IdentityHashMap;", "Ljava/util/concurrent/ConcurrentHashMap;"});

K::dispatch(arg(0)."[]" <- arg(1)),
  K::dispatch(arg(0)."[]" <- arg(2)) :-
  callsig(K, name in {"put", "putIfAbsent"}, parent in {"Ljava/util/Map;", "Ljava/util/SortedMap;", "Ljava/util/NavigableMap;", "Ljava/util/AbstractMap;", "Ljava/util/HashMap;", "Ljava/util/LinkedHashMap;", "Ljava/util/TreeMap;", "Ljava/util/Hashtable;", "Ljava/util/EnumMap;", "Ljava/util/WeakHashMap;", "Ljava/util/IdentityHashMap;", "Ljava/util/concurrent/ConcurrentHashMap;"});

// Views share the map's elements at the same level, so a bare port is exactly right.
K::dispatch(return <- arg(0)) :-
  callsig(K, name in {"keySet", "values", "entrySet"}, parent in {"Ljava/util/Map;", "Ljava/util/SortedMap;", "Ljava/util/NavigableMap;", "Ljava/util/AbstractMap;", "Ljava/util/HashMap;", "Ljava/util/LinkedHashMap;", "Ljava/util/TreeMap;", "Ljava/util/Hashtable;", "Ljava/util/EnumMap;", "Ljava/util/WeakHashMap;", "Ljava/util/IdentityHashMap;", "Ljava/util/concurrent/ConcurrentHashMap;"});

K::dispatch(return <- arg(0)) :-
  callsig(K, name in {"getKey", "getValue"}, parent = "Ljava/util/Map$Entry;");

K::dispatch(return <- arg(0)."[]") :-
  callsig(K, name in {"get", "peek", "poll", "pop", "remove", "getFirst", "getLast", "element"}, parent in {"Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/SortedSet;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/AbstractCollection;", "Ljava/util/AbstractList;", "Ljava/util/AbstractSet;", "Ljava/util/AbstractSequentialList;", "Ljava/util/ArrayList;", "Ljava/util/LinkedList;", "Ljava/util/Vector;", "Ljava/util/Stack;", "Ljava/util/HashSet;", "Ljava/util/TreeSet;", "Ljava/util/ArrayDeque;", "Ljava/util/concurrent/CopyOnWriteArrayList;", "Ljava/util/concurrent/ConcurrentLinkedQueue;"});

K::dispatch(arg(0)."[]" <- arg(1)),
  K::dispatch(arg(0)."[]" <- arg(2)) :-
  callsig(K, name in {"add", "addAll", "push", "offer", "addFirst", "addLast", "set"}, parent in {"Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/SortedSet;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/AbstractCollection;", "Ljava/util/AbstractList;", "Ljava/util/AbstractSet;", "Ljava/util/AbstractSequentialList;", "Ljava/util/ArrayList;", "Ljava/util/LinkedList;", "Ljava/util/Vector;", "Ljava/util/Stack;", "Ljava/util/HashSet;", "Ljava/util/TreeSet;", "Ljava/util/ArrayDeque;", "Ljava/util/concurrent/CopyOnWriteArrayList;", "Ljava/util/concurrent/ConcurrentLinkedQueue;"});

// ---- discards: `resolve = "skip"` means "this call moves nothing" ----
// The one lever here that can silently lose a finding, so it stays the shortest list and every
// entry is defensible alone: the only output is a primitive derived from the receiver's SHAPE.
// A void return is NOT evidence that nothing happens (`Runnable.run()V`,
// `Activity.onCreate(Bundle)V`), and primitives-in/primitive-out is a fifth of the excess and a
// third of the sites -- far too big to take wholesale. Hence keying on the contract, by name
// and descriptor and declaring type, rather than on the descriptor alone.
K::dispatch(resolve = "skip") :-
  callsig(K, name in {"hasNext", "isEmpty"}, parent in {"Ljava/util/Iterator;", "Ljava/util/ListIterator;", "Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/SortedSet;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/Map;", "Ljava/util/SortedMap;", "Ljava/util/AbstractCollection;", "Ljava/util/AbstractList;", "Ljava/util/AbstractSet;", "Ljava/util/AbstractMap;", "Ljava/util/AbstractSequentialList;"}),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(\\)Z$");

K::dispatch(resolve = "skip") :-
  callsig(K, name = "size", parent in {"Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/SortedSet;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/Map;", "Ljava/util/SortedMap;", "Ljava/util/AbstractCollection;", "Ljava/util/AbstractList;", "Ljava/util/AbstractSet;", "Ljava/util/AbstractMap;", "Ljava/util/AbstractSequentialList;"}),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(\\)I$");

K::dispatch(resolve = "skip") :-
  callsig(K, name in {"contains", "containsKey", "containsValue"}, parent in {"Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/SortedSet;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/Map;", "Ljava/util/SortedMap;", "Ljava/util/AbstractCollection;", "Ljava/util/AbstractList;", "Ljava/util/AbstractSet;", "Ljava/util/AbstractMap;", "Ljava/util/AbstractSequentialList;"}),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(Ljava/lang/Object;\\)Z$");

K::dispatch(resolve = "skip") :-
  callsig(K, name = "containsAll", parent in {"Ljava/util/Collection;", "Ljava/util/List;", "Ljava/util/Set;", "Ljava/util/SortedSet;", "Ljava/util/Queue;", "Ljava/util/Deque;", "Ljava/util/AbstractCollection;", "Ljava/util/AbstractList;", "Ljava/util/AbstractSet;", "Ljava/util/AbstractSequentialList;"}),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(Ljava/util/Collection;\\)Z$");

K::dispatch(resolve = "skip") :-
  callsig(K, name in {"indexOf", "lastIndexOf"}, parent in {"Ljava/util/List;", "Ljava/util/AbstractList;", "Ljava/util/AbstractSequentialList;"}),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(Ljava/lang/Object;\\)I$");

K::dispatch(resolve = "skip") :-
  callsig(K, name = "compareTo", parent = "Ljava/lang/Comparable;"),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(Ljava/lang/Object;\\)I$");

K::dispatch(resolve = "skip") :-
  callsig(K, name = "compare", parent = "Ljava/util/Comparator;"),
  callsig(K, signature = Sig0),
  regex_match(Sig0, "^\\(Ljava/lang/Object;Ljava/lang/Object;\\)I$");

// ---- resource release: hybrid inlining, not a model ----
// A `close()` body is where buffered data is finally handed to a file or a socket, which is
// where a sink model lives -- and the source/sink guard cannot see a sink reached THROUGH a
// target. A model of any shape here would keep taint out of that body. Hybrid inlining keeps
// the body reachable and resolves the receiver precisely when its allocation is visible, which
// for a stream it usually is. Not plain CHA either: about a fifth of an app's `close` overrides
// write a named field, and with up to 176 targets these sites would exceed the threshold and
// defer anyway; forcing it makes the disposition the same at every site of the signature. A
// site with exactly one target still takes CHA, so this never makes an exact site worse.
K::dispatch(resolve = "inline") :-
  callsig(K, name in {"close", "dispose", "cancel", "flush", "release", "recycle", "shutdown"}, parent in {"Ljava/io/Closeable;", "Ljava/lang/AutoCloseable;", "Ljava/io/InputStream;", "Ljava/io/OutputStream;", "Ljava/io/Reader;", "Ljava/io/Writer;", "Ljava/util/concurrent/Future;", "Lio/reactivex/disposables/Disposable;", "Lio/reactivex/rxjava3/disposables/Disposable;", "Landroid/database/Cursor;", "Lokio/Source;", "Lokio/Sink;", "Lokio/BufferedSource;", "Lokio/BufferedSink;"});

// ---- closure-shaped signatures: a note for `ctadl report`, not a resolution rule ----
// Names what rung 3 is FOR, so the report can say which closure-shaped signatures no model
// covers -- the per-app profiling a fixed list leaves benefit on the table for. These are
// deliberately NOT modelled: their implementations are unrelated fragments of the program, the
// receiver's identity is exactly what a context-sensitive technique recovers, and they exceed
// the CHA threshold and fall to hybrid inlining by themselves. That is the line this list is
// drawn on. They get no `resolve = "inline"` rule either: on real apps it would change nothing,
// and on a small benchmark, where a `Function1.invoke` may have three targets, it would defer
// sites CHA handles exactly.
//
// The structural single-abstract-method test finds the rest, including obfuscated ones, but it
// cannot see an interface the import does not declare. A framework name an obfuscator cannot
// touch is what covers that half.
K::dispatch(closure_shaped = true) :-
  callsig(K, parent in {"Ljava/lang/Runnable;", "Ljava/util/concurrent/Callable;", "Ljavax/inject/Provider;", "Ldagger/internal/Provider;", "Ldagger/internal/Factory;", "Ldagger/Lazy;", "Landroid/os/Parcelable$Creator;", "Lorg/reactivestreams/Subscriber;", "Lkotlinx/coroutines/flow/FlowCollector;"});

K::dispatch(closure_shaped = true) :-
  callsig(K, parent = P0),
  regex_match(P0, "^Lkotlin/jvm/functions/Function[0-9]+;$");

K::dispatch(closure_shaped = true) :-
  callsig(K, parent = P0),
  regex_match(P0, "^Ljava/util/function/");

K::dispatch(closure_shaped = true) :-
  callsig(K, parent = P0),
  regex_match(P0, "^Lio/reactivex/(rxjava3/core/)?(functions/|Observer|SingleObserver|CompletableObserver|MaybeObserver)");

// Kotlin's continuation pair: a suspend lambda's body and the factory that makes one.
K::dispatch(closure_shaped = true) :-
  callsig(K, name in {"invokeSuspend", "create"}),
  callsig(K, parent = P0),
  regex_match(P0, "^Lkotlin/coroutines/");
