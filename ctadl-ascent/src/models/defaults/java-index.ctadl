// Default propagation models for the Java frontends (VirtualMethodTable::Java -- dex, apk, jvm,
// jar). Propagation only; CTADL ships no default sources or sinks.
//
// PARENTS. `parent`/`parents` matches the class DECLARED AT THE INVOKE SITE, not the runtime
// type. A rule naming only the interface misses every call written against a concrete class,
// and vice versa -- which is why the `iterator` rule below names eight parents for one method.
// Every rule here names the interface AND the common concrete types.
//
// POSITIONAL PORTS ONLY. dex and jvm name instance fields differently -- dex wraps the field's
// `pretty_name`, jvm builds `<Lclass;->field:descriptor>` -- so a named-field port is not
// portable between the two Java frontends. `arg(n)`, `return`, and the array element are.
//
// THE ARRAY ELEMENT is `Symbol("[]")` on both dex and jvm, and a port names it as a quoted
// field: `F::arg(0)."[]"`.
//
// A port pair is a PREFIX SUBSTITUTION, not a filter: `return <- arg(0)."[]"` unwraps a level,
// `arg(0)."[]" <- arg(1)` adds one. See docs/portcullis.md §6 and the fixtures in
// `tests/tnt/port_*.tnt`.
//
// OBJECT FLOW AND TAINT FLOW. A bare pair (`return <- arg(0)`) is object flow: the output IS the
// input, so everything reachable through the input is reachable through the output. A pair whose
// output ends in `#value` (`return.#value <- arg(1)`) is taint flow only: the output was computed
// from the input, and nothing reachable through the input becomes reachable through the output
// (docs/ir.md, `value`). Object flow implies taint flow, not the reverse. Use object flow only
// where the method really hands back the object it was given -- `this` from a builder, an
// element from a container -- and taint flow for everything computed: strings, numbers, parsed
// and encoded results.
//
// MUTATED RECEIVERS. A method that changes what a receiver holds (`StringBuilder.append`,
// `OutputStream.write`, `MessageDigest.update`) writes the taint twice: at `arg(0).#value`, which
// the caller's own variable sees, and at `arg(0)."#contents".#value`, a field no source program
// can name, which reaches a caller one call up, as field-held values do and `arg(0).#value` does
// not (S8 of docs/ir.md). A method that reads the receiver's state reads
// both. A sink is wildcard by default, so a sink on the receiver sees `."#contents"` as well.
//
// ARRAYS carry their taint bare: a model producing a `byte[]` or `char[]` writes `return.#value`,
// not `return."[]"`. A model reading one reads both `arg(n)` and `arg(n)."[]"`, since a source on
// an array return labels only the bare array, while `a[i] = x` stores at the element.
// A string computed from the object. Taint held in the object's fields does not reach it.
propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name = "toString"),
  fun(F, signature = Sig0),
  regex_match(Sig0, ".*\\(\\)Ljava/lang/String;");

// `String.toString` returns `this`.
propagation(F::return <- F::arg(0)) :-
  fun(F, name = "toString", parent = "Ljava/lang/String;");

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."#contents") :-
  fun(F, name = "toString", parent in {"Ljava/lang/StringBuffer;", "Ljava/lang/StringBuilder;"});

// `append` returns `this`; what it appends is only taint.
propagation(F::return <- F::arg(0)),
  propagation(F::return.#value <- F::arg(1)),
  propagation(F::return.#value <- F::arg(1)."[]"),
  propagation(F::arg(0).#value <- F::arg(1)),
  propagation(F::arg(0).#value <- F::arg(1)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)),
  propagation(F::arg(0)."#contents".#value <- F::arg(1)."[]") :-
  fun(F, name = "append", parent in {"Ljava/lang/StringBuffer;", "Ljava/lang/StringBuilder;"});

// `insert(int offset, x, ...)`: the inserted value is `arg(2)`; `arg(1)` is the offset.
propagation(F::return <- F::arg(0)),
  propagation(F::return.#value <- F::arg(2)),
  propagation(F::return.#value <- F::arg(2)."[]"),
  propagation(F::arg(0).#value <- F::arg(2)),
  propagation(F::arg(0).#value <- F::arg(2)."[]"),
  propagation(F::arg(0)."#contents".#value <- F::arg(2)),
  propagation(F::arg(0)."#contents".#value <- F::arg(2)."[]") :-
  fun(F, name = "insert", parent in {"Ljava/lang/StringBuffer;", "Ljava/lang/StringBuilder;"});

propagation(F::return.#value <- F::arg(_)),
  propagation(F::return.#value <- F::arg(_)."[]") :-
  fun(F, name = "valueOf", parent in {"Ljava/lang/Character;", "Ljava/lang/String;", "Ljava/lang/Boolean;", "Ljava/lang/Byte;", "Ljava/lang/Short;", "Ljava/lang/Integer;", "Ljava/lang/Long;", "Ljava/lang/Float;", "Ljava/lang/Double;", "Ljava/lang/BigInteger;"});

propagation(F::return.#value <- F::arg(_)) :-
  fun(F, name = "forDigit", parent = "Ljava/lang/Character;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "booleanValue", parent = "Ljava/lang/Boolean;");

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."#contents") :-
  fun(F, name = "readLine", parent = "Ljava/io/BufferedReader;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "ordinal", parent = "Ljava/lang/Enum;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name in {"getBytes", "indexOf", "isEmpty", "lastIndexOf", "replace", "split", "subSequence", "toCharArray", "charAt"}, parent = "Ljava/lang/String;");

propagation(F::return.#value <- F::arg(0)),
  propagation(F::return.#value <- F::arg(0)."#contents") :-
  fun(F, name in {"indexOf", "isEmpty", "lastIndexOf", "subSequence", "charAt"}, parent in {"Ljava/lang/StringBuffer;", "Ljava/lang/StringBuilder;"});

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name in {"substring", "toLowerCase", "toUpperCase", "trim"}, parent = "Ljava/lang/String;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "getOutputStream", parent = "Ljava/net/HttpURLConnection;");

propagation(F::return.#value <- F::arg(0)) :-
  fun(F, name = "getAddress", parent = "Ljava/net/InetAddress;");

propagation(F::return.#value <- F::arg(0)) :-
