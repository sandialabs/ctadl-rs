{
  "_comment": "source() returns taint; every sink_<case>(v) is a sink on Argument(0). One sink name per case, so a result's sinkFunctions names the case that produced it.",
  "model_generators": [
    {
      "find": "methods",
      "where": [ { "constraint": "signature_match", "names": ["source"] } ],
      "model": { "sources": [ { "kind": "TU", "port": "Return" } ] }
    },
    {
      "find": "methods",
      "where": [ { "constraint": "signature", "pattern": "^sink_.*" } ],
      "model": { "sinks": [ { "kind": "TU", "port": "Argument(0)" } ] }
    }
  ]
}
