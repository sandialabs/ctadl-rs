// Requires a summary due to assignments. Tests that value assignments don't
// induce summaries: assigning to a parameter rebinds it, which is local to the callee.
def F(p shared_fields, q shared_fields): 1
where summaries [return.foo <- q]
{
start:
  a = q;
  p.foo = a;
  goto end;
end:
  return p;
}
