// OBJECT FLOW AND TAINT FLOW IN A MODEL -- the idiom the default models use for a builder:
// `sb.append(x)` hands back `sb` itself (`return <- arg(0)`), and what it appends is only taint
// (`return.#value <- arg(1)`, `arg(0).#value <- arg(1)`), written a second time at
// a field held in memory, which reaches a caller one call up. The defaults name that field
// `"#contents"`, which flowy cannot spell; here it is `contents`. The model is
// `model_value_flow.models.ctadl`.
def append(sb, x): 1
{
start:
  w = "nothing";
  return w;
}

def addto(p, v): 1
{
start:
  r = append(p, v);
  w = "nothing";
  return w;
}

def main() {
start:
  // What is appended taints the result and the builder.
  t = source(Appended);
  r = append(sb, t);
  sink(r, Appended);
  sink(sb, Appended);

  // ... and a copy of the builder made before the call.
  a = source(Aliased);
  sb4 = sb5;
  r2 = append(sb4, a);
  sink(sb5, Aliased);

  // Taint flow carries nothing reachable through the argument: `u.f` is not `r3.f`.
  u.f = source(Field);
  r3 = append(sb3, u);
  y = r3.f;
  errsink(y, Field);
  errsink(r3, Field);
  z = sb3.f;
  errsink(z, Field);
  uf = u.f;
  sink(uf, Field);

  // Object flow does: the builder's own fields come back with it.
  o.f = source(Object);
  clean = "nothing";
  r4 = append(o, clean);
  q = r4.f;
  sink(q, Object);

  // Appended in a callee, the taint reaches the caller's builder through `.contents` only.
  c = source(Callee);
  k = addto(sbc, c);
  e = sbc.contents;
  sink(e, Callee);
  errsink(sbc, Callee);
  return;
}
