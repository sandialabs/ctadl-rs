// A callback stored to a global under a decision resolves a call through the global:
// `build` stores `cb` into `g` only because `main` passes `store` as `reg`.
var g;

def cb(v) {
start:
  sink(v, Secret);
  return;
}

def store(f) {
start:
  g.deref = f;
  return;
}

def build(reg) {
start:
  k = ptr<cb>;
  reg(k);
  return;
}

def main() {
start:
  s = ptr<store>;
  build(s);
  v = source(Secret);
  h = g.deref;
  h(v);
  return;
}
