// A tainted return value must not flow back onto the field the callee read.
//
// `width_of`'s return carries a source and its summary is `return <- p.width`. The call-site smear
// let empty-path taint on the return flow backwards through the load, onto `p.width` and on to the
// caller's earlier read `w`, so `errsink(w, S)` fired. No saturating source is involved.
def width_of(p): 1
where summaries [return <- p.width]
{
s:
  x = source(S);
  r = p.width, x;
  return r;
}

def main(p) {
s:
  w = p.width;
  r = width_of(p);
  sink(r, S);
  errsink(w, S);
  return;
}
