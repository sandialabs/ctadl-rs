// A source created inside a callee and stored to a global is read by the caller after the call,
// and by consume(), which the caller calls next: one global, shared by every instance (G2).
var g;
var clean;

def produce() {
start:
  x = source(Secret);
  sink(x, Secret);
  g.deref = x;
  return;
}

def consume() {
start:
  y = g.deref;
  sink(y, Secret);
  errsink(clean, Secret);
  return;
}

def main() {
start:
  produce();
  y = g.deref;
  sink(y, Secret);
  consume();
  errsink(clean, Secret);
  return;
}
