// `skip_analysis`, IN THE DSL -- the same fixture as `skip_analysis.tnt`, modelled in the model
// DSL rather than in JSON. Drop the `skip_analysis(F)` head from
// `skip_analysis_portcullis.models.ctadl` and the `return </- src` check fails: the body's flow
// is back.
//
// What the directive replaces, and how, is in `skip_analysis.tnt`.
def transfer(dst, src): 1
where summaries [return </- src, return <- dst]
{
start:
  return src;
}

// One source, taken through the same function twice. Both checks read the same taint, so
// neither can pass by the source having gone missing.
def main() {
start:
  a = source(Secret);
  clean = "nothing";
  // The model's port: arg(0) reaches the return.
  viaModel = transfer(a, clean);
  sink(viaModel, Secret);

  // The body's flow, which the model does not declare and the directive suppresses.
  viaBody = transfer(clean, a);
  errsink(viaBody, Secret);
  return;
}
