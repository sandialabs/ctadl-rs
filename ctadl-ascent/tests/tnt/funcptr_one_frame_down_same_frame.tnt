// A function pointer installed in a struct field one frame below the frame that owns the
// struct, then called through that field in that same frame. `funcptr_one_frame_down.tnt` makes
// the call from a third function instead.
//
// The sinks in `sink_strips` and `sink_tiles` must both be reached. `put_never` is installed in
// the sibling field `put`, which is never called, so `sink_clean` must stay silent. Each sink is
// one call below its target so that reaching it means entering the target.

def sink_strips(v) {
start:
  sink(v, Height);
  return;
}

def sink_tiles(v) {
start:
  sink(v, Height);
  return;
}

def sink_clean(v) {
start:
  errsink(v, Height);
  return;
}

def get_strips(im shared, h):1 {
start:
  sink_strips(h);
  return h;
}

def get_tiles(im shared, h):1 {
start:
  sink_tiles(h);
  return h;
}

def put_never(im shared, h):1 {
start:
  sink_clean(h);
  return h;
}

// Installs the targets. No indirect call here.
def pick(im shared) {
start:
  goto tiled, strips;
tiled:
  im.get = ptr<get_tiles>;
  goto done;
strips:
  im.get = ptr<get_strips>;
  goto done;
done:
  im.put = ptr<put_never>;
  return;
}

def main() {
start:
  h = source(Height);
  pick(im);
  f = im.get;
  r = f(im, h);
  return;
}
