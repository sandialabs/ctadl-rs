// The misses `cil:taint` accepts, one entry per flow.
//
// - `method`: `Ns.Class::Method`, with the descriptor if it is overloaded, in any fixture.
// - `flow`: `src -> dst`, each `argN`, `ret` or `throw` and then `.segment`s; a field may drop
//   its assembly and namespace (`<Node::Value>`), and `seg*` matches it zero or more times.
// - `kind`: one of
//   - `engine:path-composition`: the index composes no path for the flow, as along a field
//     a loop walks;
//   - `engine:alias-rule`: the aliasing rule summarizes only paths the program stores through;
//   - `design:unresolved-address-write`: a write through an address the frontend cannot
//     resolve (two addresses merged at a join) reaches the pointer's target, not the places
//     the address may name;
//   - `design:call-graph`: the flow crosses a virtual, interface or delegate call, which the
//     index does not resolve while the call graph is reworked.
//   The report counts XFAILs per kind, so an engine fix shows as its kind going to zero.
// - `why`: required; an `engine:` entry names the `.tnt` reproducer in
//   `ctadl-ascent/tests/tnt` that shows the limitation without CIL.
//
// An entry that matches no uncovered flow is an XPASS and fails the check: the index covers
// the flow now, or the fixture no longer shows it, and either way the entry goes.
[
  {
    method: "Exec.Obj::ObjectField",
    flow: "arg1 -> ret.<Node::Value>",
    kind: "engine:path-composition",
    why: "`b.O = new Node { Value = a }` stores an object whose field was stored, and no statement spells `.O.Value`, so the index does not admit it (tnt: path_composition_store.tnt)",
  },
  {
    method: "Exec.Obj::ObjectField",
    flow: "arg0 -> ret.<Bag::O>",
    kind: "engine:alias-rule",
    why: "`b.O = b` makes a cycle, and the returned `b.O` is `b` again; the aliasing rule summarizes only the paths the program stores through (tnt: alias_cycle.tnt)",
  },
  {
    method: "Exec.Dels::Closure",
    flow: "arg0 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a delegate invocation, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Dels::Field",
    flow: "arg0.<Scaler::K> -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a delegate invocation, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Dels::Field",
    flow: "arg1 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a delegate invocation, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Dels::Instance",
    flow: "arg0.<Scaler::K> -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a delegate invocation, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Dels::Instance",
    flow: "arg1 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a delegate invocation, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Dels::Lambda",
    flow: "arg0 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a delegate invocation, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Dels::Static",
    flow: "arg0 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a delegate invocation, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Ifaces::Explicit",
    flow: "arg1 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses an interface call, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Ifaces::Pick",
    flow: "arg0 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses an interface call, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Ifaces::Pick",
    flow: "arg1 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses an interface call, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Ifaces::Through",
    flow: "arg1 -> arg0.<Disk::R>",
    kind: "design:call-graph",
    why: "the flow crosses an interface call, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Ifaces::Through",
    flow: "arg1 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses an interface call, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Obj::Instance",
    flow: "arg0.<Rc::W> -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a virtual call, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Obj::Instance",
    flow: "arg0.<Sq::S> -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a virtual call, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Obj::MakeShapes",
    flow: "arg0 -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a virtual call, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Obj::Virt",
    flow: "arg0.<Rc::W> -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a virtual call, which the index does not resolve while the call graph is reworked",
  },
  {
    method: "Exec.Obj::Virt",
    flow: "arg0.<Sq::S> -> ret",
    kind: "design:call-graph",
    why: "the flow crosses a virtual call, which the index does not resolve while the call graph is reworked",
  },
]
